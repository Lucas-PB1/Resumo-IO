FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBA...[CHAVE_COMPLETA_AQUI_UMA_LINHA_SÓ_COM_\n]...\n-----END PRIVATE KEY-----\n"


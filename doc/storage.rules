rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public/Private user profile folder
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }

    // Private templates folder (.docx only)
    match /templates/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                        && request.resource.size < 10 * 1024 * 1024;
    }

    // Private reports folder (Word and PDF results)
    match /reports/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                        && request.resource.size < 20 * 1024 * 1024;
    }

    // Private evidence folder (source data attachments)
    match /evidence/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
